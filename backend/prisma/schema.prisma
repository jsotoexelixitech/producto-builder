generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PRODUCT_MANAGER
  VIEWER
  AUDITOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(PRODUCT_MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

enum ProductBranch {
  AUTOMOVIL
  SALUD
  VIDA
  PATRIMONIAL
  INCLUSIVO
  RCV_OBLIGATORIO
}

enum ContractCurrency {
  VES
  USD
  EUR
  INDEXADO
}

enum PremiumCalculationType {
  PRIMA_FIJA
  TASA_PORCENTUAL
}

enum CoreSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum EmissionType {
  EMISION_GARANTIZADA
  REQUIERE_DECLARACION_SALUD
  REQUIERE_INSPECCION
}

enum ProductStatus {
  DRAFT
  ACTUARIAL_REVIEW
  SUBMITTED_TO_SUDEASEG
  APPROVED_ACTIVE
  REJECTED
}

enum RenewalFrequency {
  ANUAL
  SEMESTRAL
  TRIMESTRAL
  MENSUAL
}

enum RenewalType {
  NORMAL
  TACITA
  CON_AVISO
}

enum DeductibleType {
  MONTO_FIJO
  PORCENTAJE_SINIESTRO
  PORCENTAJE_SUMA_ASEGURADA
}

enum DocumentType {
  CONDICIONES_GENERALES
  CONDICIONES_PARTICULARES
  NOTA_TECNICA_ACTUARIAL
  POLIZA
  CUADRO_RECIBO
}

enum FormFieldType {
  TEXT
  NUMBER
  SELECT
  DATE
  BOOLEAN
}

model Product {
  id                        String           @id @default(uuid())
  commercialName            String
  internalCode              String           @unique
  branch                    ProductBranch
  currency                  ContractCurrency
  emissionType              EmissionType
  status                    ProductStatus    @default(DRAFT)
  simplifiedContract        Boolean          @default(false)
  uniformConditions         Boolean          @default(false)
  lockedGeneralConditions   Boolean          @default(false)
  numeroProvidenciaSudeaseg String?
  fechaGacetaAprobacion     DateTime?
  isImmutable               Boolean          @default(false)
  /** Visible en el catálogo de emisión (activar/desactivar sin borrar). */
  catalogVisible            Boolean          @default(true)

  /** Sub-ramo CORE (filtrado por branch). */
  subBranchCode             String?
  subBranchName             String?

  /** Sincronización con núcleo corporativo (CORE / SISIP). */
  coreProductCode           String?
  coreSyncedAt              DateTime?
  coreSyncStatus            CoreSyncStatus?
  coreSyncError             String?

  // Plan SISIP
  subPlanCode          String?
  vigenciaInicio       DateTime?
  vigenciaFin          DateTime?
  allowsQuickEmission  Boolean           @default(false)
  renewalFrequency     RenewalFrequency?
  renewalType          RenewalType?
  premiumGuaranteeDays Int?
  annualClosingMonth   Int?

  actuarialData      ActuarialData?
  coverages          Coverage[]
  exclusions         Exclusion[]
  legalDocuments     LegalDocument[]
  stateHistory       ProductStateHistory[]
  formFields         FormField[]
  commercialChannels CommercialChannel[]
  requiredDocuments  RequiredDocument[]
  productPlans       ProductPlan[]
  flowStepConfigs    FlowStepConfig[]
  sisipConfig        ProductSisipConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branch])
}

model Coverage {
  id                String          @id @default(uuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  sortOrder         Int             @default(0)
  isBasicMandatory  Boolean         @default(false)
  insuredSumMin     Decimal?        @db.Decimal(18, 2)
  insuredSumMax     Decimal?        @db.Decimal(18, 2)
  insuredSumFixed   Decimal?        @db.Decimal(18, 2)
  deductibleType    DeductibleType?
  deductibleValue   Decimal?        @db.Decimal(18, 4)
  waitingPeriodDays Int             @default(0)

  premiumCalculationType PremiumCalculationType @default(PRIMA_FIJA)
  tariffRate             Decimal?               @db.Decimal(8, 4)
  subLimitPercent        Decimal?               @db.Decimal(8, 4)
  accountingCode         String?

  // Tarifa y vigencia SISIP
  tariffPremium           Decimal?  @db.Decimal(18, 4)
  vigenciaDesde           DateTime?
  vigenciaHasta           DateTime?
  dependsOnCoverageName   String?
  coberturaInternaCode    String?
  tarifaInternaCode       String?
  treatmentType           String?
  calculationService      String?
  reinsuranceContractCode String?
  reinsuranceContractName String?
  reinsuranceBranchCode   String?

  @@index([productId])
}

/// Catálogo de sub-ramos alineado al CORE (consulta / filtro por ramo principal).
model CoreSubBranch {
  id           String        @id @default(uuid())
  branch       ProductBranch
  coreRamoCode String
  code         String
  name         String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coverages CoreCoverageCatalog[]

  @@unique([branch, code])
  @@index([branch])
  @@index([coreRamoCode])
}

/// Coberturas maestras del CORE (dropdown + alta sincronizada).
model CoreCoverageCatalog {
  id             String         @id @default(uuid())
  branch         ProductBranch
  subBranchCode  String?
  subBranch      CoreSubBranch? @relation(fields: [branch, subBranchCode], references: [branch, code])
  code           String
  name           String
  accountingCode String?
  isActive       Boolean        @default(true)
  source         String         @default("CORE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([branch, code])
  @@index([branch, subBranchCode])
}

/// Registro de productos publicados en el CORE (mirror local + import).
model CoreProductRegistry {
  id              String        @id @default(uuid())
  coreCode        String        @unique
  productId       String?
  branch          ProductBranch
  subBranchCode   String?
  commercialName  String
  internalCode    String
  payload         Json
  syncedAt        DateTime      @default(now())
  source          String        @default("LOCAL")

  @@index([branch])
  @@index([productId])
}

model ProductSisipConfig {
  id                    String  @id @default(uuid())
  productId             String  @unique
  product               Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ramoInternoCode       String?
  ramoInternoName       String?
  branchAlias1          String?
  branchAlias2          String?
  producerCode          String?
  producerName          String?
  assignToAllProducers  Boolean @default(false)

  counterCotizacion     String  @default("COTIZACION")
  counterPoliza         String  @default("POLIZA")
  counterRecibo         String  @default("RECIBO")
  counterSiniestro      String  @default("SINIESTRO")

  maskPoliza            String?
  maskRecibo            String?
  maskSiniestro         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActuarialData {
  id                     String  @id @default(uuid())
  productId              String  @unique
  product                Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  purePremium            Decimal @db.Decimal(18, 4)
  administrativeExpenses Decimal @db.Decimal(8, 4)
  commissions            Decimal @db.Decimal(8, 4)
  profitMargin           Decimal @db.Decimal(8, 4)
  commercialPremium      Decimal @db.Decimal(18, 4)
  actuaryName            String
  actuaryCedula          String
  actuarySudeasegNumber  String
  technicalNoteUrl       String?

  ratingVariables RatingVariable[]
}

model RatingVariable {
  id              String        @id @default(uuid())
  actuarialDataId String
  actuarialData   ActuarialData @relation(fields: [actuarialDataId], references: [id], onDelete: Cascade)
  name            String
  label           String
  variableType    FormFieldType
  required        Boolean       @default(true)
  options         Json?
  sortOrder       Int           @default(0)

  @@index([actuarialDataId])
}

model Exclusion {
  id                  String  @id @default(uuid())
  productId           String
  product             Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  text                String
  sortOrder           Int     @default(0)
  typographyHighlight Boolean @default(true)

  @@index([productId])
}

model LegalDocument {
  id                   String       @id @default(uuid())
  productId            String
  product              Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  documentType         DocumentType
  title                String
  content              String       @db.Text
  isLocked             Boolean      @default(false)
  isSimplifiedTemplate Boolean      @default(false)

  @@index([productId])
}

model CommercialChannel {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  channelType String

  @@index([productId])
}

model FormField {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  fieldType FormFieldType
  required  Boolean       @default(true)
  options   Json?
  sortOrder Int           @default(0)
  stepKey   String        @default("RISK_DATA")

  @@index([productId])
}

model ProductPlan {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  badge         String?
  /** Prima total del plan (o factor legacy). Decimal amplio: antes Decimal(8,4) desbordaba primas > 9999. */
  priceFactor   Decimal  @default(1) @db.Decimal(18, 4)
  isRecommended Boolean  @default(false)
  coverageIds   Json?
  coverageLabels Json?
  assignedChannel String?
  sortOrder     Int      @default(0)

  @@index([productId])
}

model FlowStepConfig {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  stepKey     String
  label       String
  shortLabel  String?
  description String?
  enabled     Boolean @default(true)
  formEnabled Boolean @default(true)
  sortOrder   Int     @default(0)

  @@unique([productId, stepKey])
  @@index([productId])
}

model RequiredDocument {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  documentKey String
  label       String
  required    Boolean @default(true)
  sortOrder   Int     @default(0)

  @@index([productId])
}

model ProductStateHistory {
  id         String         @id @default(uuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus ProductStatus?
  toStatus   ProductStatus
  comment    String?
  changedBy  String?
  changedAt  DateTime       @default(now())

  @@index([productId])
}

/// Cómo se obtiene la suma asegurada de una cobertura de Sis2000 (cramo + ccobertura).
/// CALCULADA = unidades × valor por unidad, ambos llegan al emitir. Sis2000 no tiene columnas para esto.
enum TipoSumaAsegurada {
  FIJA
  CALCULADA
}

model CoberturaSumaConfig {
  id             String            @id @default(uuid())
  cramo          Int
  ccobertura     String
  tipoSuma       TipoSumaAsegurada @default(FIJA)
  /// Nombre genérico de la unidad en el sistema (opcional).
  unidadCalculo  String?
  /// Palabra que sale en el cuadro póliza (obligatoria si CALCULADA).
  etiquetaCuadro String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([cramo, ccobertura])
}

/// Entidades de Sis2000 que el configurador respalda antes de modificarlas (copia en esta Postgres, no en Sis2000).
enum Sis2000EntidadRespaldo {
  PRODUCTO
  COBERTURA
  TARIFA
  PLAN
  PLAN_PROVEEDORES
}

enum Sis2000TipoVersion {
  CREACION
  CAMBIO
  ELIMINACION
  RESTAURACION
}

/// PENDIENTE = se guardó lo que había y se está escribiendo en Sis2000; APLICADA / FALLIDA al terminar.
enum Sis2000ResultadoVersion {
  PENDIENTE
  APLICADA
  FALLIDA
}

/// Copia original de una entidad de Sis2000: lo que había antes de que el configurador la modificara por primera vez.
/// Se guarda una sola vez y nunca se sobreescribe (un trigger de la migración lo impide). existia = false si la creó el configurador.
model Sis2000Respaldo {
  id            String                 @id @default(uuid())
  entidad       Sis2000EntidadRespaldo
  /// "cramo-ccobertura", "cramo-ccober-ctarifa", "cramo-cplan" o cproducto.
  clave         String
  existia       Boolean
  original      Json?
  usuarioId     String?
  usuarioEmail  String?
  usuarioNombre String?
  createdAt     DateTime               @default(now())
  versiones     Sis2000Version[]

  @@unique([entidad, clave])
}

/// Cada escritura del configurador en Sis2000: lo que había antes (se guarda antes de escribir), lo que quedó,
/// lo que se envió, qué cambió, quién, cuándo y por qué. Lo que había antes no se puede modificar después.
model Sis2000Version {
  id              String                  @id @default(uuid())
  respaldoId      String
  respaldo        Sis2000Respaldo         @relation(fields: [respaldoId], references: [id])
  numero          Int
  tipo            Sis2000TipoVersion
  resultado       Sis2000ResultadoVersion @default(PENDIENTE)
  anterior        Json?
  estado          Json?
  payload         Json?
  /// [{ campo, antes, despues }]
  cambios         Json?
  motivo          String?
  /// "ORIGINAL" o "<id de versión>:antes|despues" cuando es una restauración.
  restauradaDesde String?
  error           String?
  usuarioId       String?
  usuarioEmail    String?
  usuarioNombre   String?
  createdAt       DateTime                @default(now())
  terminadaEn     DateTime?

  @@unique([respaldoId, numero])
  @@index([respaldoId, createdAt])
}
