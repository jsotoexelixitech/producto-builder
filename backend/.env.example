# Desarrollo local (docker compose up en raíz del monorepo)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insurance_product_builder?schema=public"

# srv001 / Docker deploy (deploy/docker-compose.db.yml)
# DATABASE_URL="postgresql://producto_builder:ProductoBuilder_2026!@127.0.0.1:5432/producto_builder?schema=public"

PORT=3001
API_GLOBAL_PREFIX=producto-builder-api
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PRODUCT_BUILDER_PUBLIC_URL="http://localhost:5173"

# Puente emisión genérica + catálogo Sis2000 (partner Gestacio)
NEST_API_URL="http://127.0.0.1:3002"
# Key nest-api (panel /admin). Scopes mínimos Sis2000 QA:
#   partner:products · partner:starter · catalog:read (valrep planes/producto)
# Coberturas/tarifas maestro usan rutas /api/v1/catalogos/* y catalog:sis2000 si aplica.
NEST_API_KEY=""
OCR_API_URL="http://127.0.0.1:4001"

# Filtro valrep planes/producto (producto 24 RCV → P / 80080 en cierre)
SIS2000_CENTIDAD=P
SIS2000_CITEM=80080

# Núcleo corporativo alternativo (HTTP genérico). Vacío = solo Sis2000 vía NEST_API_KEY o registro local.
CORE_API_URL=""
CORE_API_KEY=""
